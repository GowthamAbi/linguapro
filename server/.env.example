# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/linguapro
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Optional AI provider configuration; keep keys server-side only.
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=# Email address allowed to access the owner dashboard API.
OWNER_EMAIL=owner@example.com
